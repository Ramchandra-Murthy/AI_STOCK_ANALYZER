# Independent React + FastAPI image. Build from the repository root:
# docker build -f Dockerfile.api -t eros-react-api .
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim AS python-deps
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN python -m pip install --no-cache-dir --only-binary=:all: "uv==0.12.1" \
    && uv sync --locked --no-dev --no-install-project --no-build \
    && rm -rf /root/.cache/uv

FROM python:3.13-slim AS runtime
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY --from=python-deps /app/.venv /app/.venv

# Copy only runtime packages required by api.main and its imported services.
# This intentionally excludes repository-wide data, reports, tests, backups,
# developer tooling, Streamlit secrets, local databases and environment files.
COPY api/ /app/api/
COPY scanner/ /app/scanner/
COPY services/ /app/services/
COPY modules/ /app/modules/
COPY config/ /app/config/
COPY core/ /app/core/
COPY domain/ /app/domain/
COPY engine/ /app/engine/
COPY indicators/ /app/indicators/
COPY utils/ /app/utils/
COPY data/ /app/data/
COPY database/ /app/database/
COPY ai/ /app/ai/
COPY ai_trading/ /app/ai_trading/
COPY algorithmic_trading/ /app/algorithmic_trading/
COPY components/ /app/components/
COPY capital/ /app/capital/
COPY charts/ /app/charts/
COPY exceptions/ /app/exceptions/
COPY forecast/ /app/forecast/
COPY interfaces/ /app/interfaces/
COPY portfolio/ /app/portfolio/
COPY strategy/ /app/strategy/
COPY neural_networks/ /app/neural_networks/

COPY pyproject.toml uv.lock /app/
COPY --from=frontend-build /frontend/dist /app/frontend/dist

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app /home/appuser
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).read()" || exit 1

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
