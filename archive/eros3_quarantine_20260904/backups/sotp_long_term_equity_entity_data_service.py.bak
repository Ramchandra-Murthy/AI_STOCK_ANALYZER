def _safe_float(value: Any):
    try:
        if value is None:
            return None

        value = float(value)

        if value != value:
            return None

        return value

    except (TypeError, ValueError):
        return None


def _validate_note_39_population(
    population: List[Dict[str, Any]],
) -> Dict[str, Any]:

    expected_count = RELIANCE_NOTE_39_EXPECTED_POPULATION_COUNT
    expected_serials = set(range(1, expected_count + 1))

    actual_count = len(population)

    serials: List[int] = []
    names: List[str] = []

    missing_name_serials: List[int] = []
    missing_country_serials: List[int] = []
    missing_ownership_serials: List[int] = []
    invalid_ownership_serials: List[int] = []
    invalid_serial_rows: List[int] = []

    for row_index, entity in enumerate(population, start=1):

        serial = entity.get("note_39_serial")

        if isinstance(serial, int):
            serials.append(serial)
        else:
            invalid_serial_rows.append(row_index)

        name = str(entity.get("name") or "").strip()

        if name:
            names.append(name)
        elif isinstance(serial, int):
            missing_name_serials.append(serial)

        country = str(entity.get("country") or "").strip()

        if not country and isinstance(serial, int):
            missing_country_serials.append(serial)

        ownership = _safe_float(entity.get("ownership_percent"))

        if ownership is None:
            if isinstance(serial, int):
                missing_ownership_serials.append(serial)

        elif not (0.0 <= ownership <= 100.0):
            if isinstance(serial, int):
                invalid_ownership_serials.append(serial)

    serial_set = set(serials)

    missing_serials = sorted(expected_serials - serial_set)

    unexpected_serials = sorted(serial_set - expected_serials)

    duplicate_serials = sorted(
        {serial for serial in serials if serials.count(serial) > 1}
    )

    normalized_names = [name.casefold() for name in names]

    duplicate_names = sorted(
        {
            names[index]
            for index, normalized_name in enumerate(normalized_names)
            if normalized_names.count(normalized_name) > 1
        }
    )

    population_valid = all(
        [
            actual_count == expected_count,
            len(serials) == expected_count,
            not invalid_serial_rows,
            not missing_serials,
            not unexpected_serials,
            not duplicate_serials,
            not duplicate_names,
            not missing_name_serials,
            not missing_country_serials,
            not missing_ownership_serials,
            not invalid_ownership_serials,
        ]
    )

    return {
        "expected_count": expected_count,
        "actual_count": actual_count,
        "serial_count": len(serials),
        "missing_serials": missing_serials,
        "unexpected_serials": unexpected_serials,
        "duplicate_serials": duplicate_serials,
        "duplicate_names": duplicate_names,
        "invalid_serial_rows": invalid_serial_rows,
        "missing_name_serials": missing_name_serials,
        "missing_country_serials": missing_country_serials,
        "missing_ownership_serials": missing_ownership_serials,
        "invalid_ownership_serials": invalid_ownership_serials,
        "population_valid": population_valid,
    }


def get_sotp_long_term_equity_entity_data(
    symbol: str,
) -> Dict[str, Any]:

    symbol = str(symbol or "").upper().strip()

    if symbol.endswith(".NS"):
        symbol = symbol[:-3]

    if symbol != "RELIANCE":
        return {
            "status": "UNAVAILABLE",
            "version": "V5.0",
            "symbol": symbol,
            "message": (
                "Entity-level long-term equity evidence "
                "is not configured for this symbol."
            ),
        }

    # ======================================================
    # AUTHORITATIVE NOTE 39 POPULATION
    # ======================================================

    population = [dict(entity) for entity in RELIANCE_LONG_TERM_EQUITY_POPULATION]

    population_count = len(population)

    population_validation = _validate_note_39_population(population)

    population_with_ownership = sum(
        1
        for entity in population
        if _safe_float(entity.get("ownership_percent")) is not None
    )

    # ======================================================
    # ANNEXURE A ENTITY-LEVEL EVIDENCE
    # ======================================================

    annexure_entities = [dict(entity) for entity in RELIANCE_LONG_TERM_EQUITY_ENTITIES]

    annexure_entity_count = len(annexure_entities)

    annexure_entities_with_ownership = sum(
        1
        for entity in annexure_entities
        if _safe_float(entity.get("ownership_percent")) is not None
    )

    annexure_entities_with_investment_value = sum(
        1
        for entity in annexure_entities
        if _safe_float(entity.get("reported_investment_value")) is not None
    )

    captured_investment_value = sum(
        _safe_float(entity.get("reported_investment_value")) or 0.0
        for entity in annexure_entities
    )

    # ======================================================
    # ACCOUNTING AGGREGATE
    # ======================================================

    reported_aggregate = 16226.0

    coverage_ratio = (
        captured_investment_value / reported_aggregate
        if reported_aggregate > 0
        else 0.0
    )

    # ======================================================
    # COMPLETENESS / BRIDGE CONTROLS
    # ======================================================
    #
    # IMPORTANT:
    #
    # A non-empty Note 39 population does NOT by itself
    # establish completeness.
    #
    # This flag must remain False until the full population
    # has been captured and independently validated against
    # the authoritative Note 39 disclosure.
    #
    # Likewise, Annexure A investment amounts must not be
    # summed and treated as a reconciliation to the
    # consolidated accounting aggregate.
    # ======================================================

    complete_entity_population = False
    bridge_ready = False

    return {
        "status": "OK",
        "version": "V5.0",
        "symbol": symbol,
        "period": "2026-03-31",
        "currency": "INR",
        "unit": "crore",
        # --------------------------------------------------
        # Accounting aggregate
        # --------------------------------------------------
        "reported_long_term_equity_investment": reported_aggregate,
        # --------------------------------------------------
        # Authoritative Note 39 population
        # --------------------------------------------------
        "population_source": (
            "Note 39 - Enterprises Consolidated as "
            "Associates and Joint Ventures under Ind AS 28"
        ),
        "population_count": population_count,
        "population_expected_count": (RELIANCE_NOTE_39_EXPECTED_POPULATION_COUNT),
        "population_with_ownership": population_with_ownership,
        "population_validation": population_validation,
        "population_integrity_valid": (population_validation["population_valid"]),
        "population": population,
        # --------------------------------------------------
        # Annexure A evidence
        # --------------------------------------------------
        "annexure_evidence_count": annexure_entity_count,
        "annexure_entities_with_ownership": annexure_entities_with_ownership,
        "annexure_entities_with_investment_value": (
            annexure_entities_with_investment_value
        ),
        "captured_investment_value": round(
            captured_investment_value,
            2,
        ),
        "captured_value_coverage": round(
            coverage_ratio,
            4,
        ),
        "captured_value_coverage_percent": round(
            coverage_ratio * 100.0,
            2,
        ),
        "annexure_entities": annexure_entities,
        # --------------------------------------------------
        # Compatibility fields
        # --------------------------------------------------
        "entity_count": annexure_entity_count,
        "entities_with_ownership": annexure_entities_with_ownership,
        "entities_with_investment_value": annexure_entities_with_investment_value,
        "entities": annexure_entities,
        # --------------------------------------------------
        # Controls
        # --------------------------------------------------
        "complete_entity_population": complete_entity_population,
        "entity_population_complete": complete_entity_population,
        "entity_level_holdings_available": (annexure_entity_count > 0),
        "entity_level_holdings_complete": complete_entity_population,
        "bridge_ready": bridge_ready,
        "interpretation": (
            "The service separates the authoritative "
            "Note 39 associate/JV population from "
            "Annexure A entity-level investment evidence. "
            "Annexure A does not establish completeness "
            "of the consolidated associate/JV population "
            "and must not be treated as a reconciliation "
            "of the reported Long-Term Equity Investment "
            "aggregate."
        ),
        "warnings": [
            (
                "The authoritative Note 39 population "
                "has not yet been validated as complete."
            ),
            (
                "Annexure A evidence must not be used "
                "as a substitute for the Note 39 "
                "associate/JV population."
            ),
            (
                "Entity-level evidence availability does "
                "not mean entity-level classification "
                "is complete."
            ),
            ("Operating overlap and valuation basis remain unresolved."),
            (
                "Reported investment amounts are "
                "accounting evidence and are not "
                "automatically fair values."
            ),
            ("The ₹16,226 crore adjustment remains blocked."),
        ],
    }
