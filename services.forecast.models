"""
Module: services.forecast.models
Description: Canonical institutional-grade domain models for the Forecast Engine.
Author: Engineering Team
Python Version: 3.13+
"""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Dict, Optional, Tuple, Protocol, runtime_checkable

__all__ = [
    "ForecastMethod",
    "ConfidenceLevel",
    "ForecastProtocol",
    "ForecastSeries",
    "RevenueForecast",
    "MarginForecast",
    "CapexForecast",
    "DepreciationForecast",
    "WorkingCapitalForecast",
    "TaxForecast",
    "TerminalGrowthForecast",
    "ForecastAssumption",
    "ForecastScenario",
    "ForecastConfidence",
]


class ForecastMethod(str, Enum):
    """Supported institutional financial forecasting methods."""

    CAGR = "cagr"
    ROLLING_AVERAGE = "rolling_average"
    LINEAR_REGRESSION = "linear_regression"
    MEAN_REVERSION = "mean_reversion"
    EXPONENTIAL_SMOOTHING = "exponential_smoothing"
    MANUAL = "manual"
    INDUSTRY = "industry"
    MANAGEMENT_GUIDANCE = "management_guidance"
    HYBRID = "hybrid"


class ConfidenceLevel(str, Enum):
    """Statistical confidence tier associated with a forecast projection."""

    VERY_HIGH = "very_high"
    HIGH = "high"
    MEDIUM = "medium"
    LOW = "low"
    VERY_LOW = "very_low"


@runtime_checkable
class ForecastProtocol(Protocol):
    """Protocol defining the structural interface for immutable forecast models."""

    historical: Tuple[float, ...]
    projected: Tuple[float, ...]
    method: ForecastMethod
    confidence: ConfidenceLevel

    def to_dict(self) -> Dict[str, Any]:
        """Serializes the forecast model to a standard dictionary representation."""
        ...


@dataclass(slots=True, frozen=True)
class ForecastSeries:
    """Base immutable representation of a financial time-series projection."""

    historical: Tuple[float, ...] = field(default_factory=tuple)
    projected: Tuple[float, ...] = field(default_factory=tuple)
    method: ForecastMethod = ForecastMethod.CAGR
    confidence: ConfidenceLevel = ConfidenceLevel.MEDIUM

    def __post_init__(self) -> None:
        """Validates structural invariants and type coercions upon instantiation."""
        if not isinstance(self.historical, tuple):
            object.__setattr__(self, "historical", tuple(self.historical))
        if not isinstance(self.projected, tuple):
            object.__setattr__(self, "projected", tuple(self.projected))
        if not isinstance(self.method, ForecastMethod):
            try:
                object.__setattr__(self, "method", ForecastMethod(self.method))
            except ValueError:
                object.__setattr__(self, "method", ForecastMethod.CAGR)
        if not isinstance(self.confidence, ConfidenceLevel):
            try:
                object.__setattr__(self, "confidence", ConfidenceLevel(self.confidence))
            except ValueError:
                object.__setattr__(self, "confidence", ConfidenceLevel.MEDIUM)

    def to_dict(self) -> Dict[str, Any]:
        """Serializes the base forecast series payload."""
        return {
            "historical": list(self.historical),
            "projected": list(self.projected),
            "method": self.method.value,
            "confidence": self.confidence.value,
        }

    @classmethod
    from_dict(cls, data: Dict[str, Any]) -> ForecastSeries:
        """Constructs an instance from a dictionary payload."""
        return cls(
            historical=tuple(data.get("historical", [])),
            projected=tuple(data.get("projected", [])),
            method=ForecastMethod(data.get("method", ForecastMethod.CAGR.value)),
            confidence=ConfidenceLevel(data.get("confidence", ConfidenceLevel.MEDIUM.value)),
        )


@dataclass(slots=True, frozen=True)
class RevenueForecast(ForecastSeries):
    """Immutable domain model for projected revenue streams."""

    growth_rates: Tuple[float, ...] = field(default_factory=tuple)

    def __post_init__(self) -> None:
        super().__post_init__()
        if not isinstance(self.growth_rates, tuple):
            object.__setattr__(self, "growth_rates", tuple(self.growth_rates))

    def to_dict(self) -> Dict[str, Any]:
        base = super().to_dict()
        base.update({"growth_rates": list(self.growth_rates)})
        return base

    @classmethod
    from_dict(cls, data: Dict[str, Any]) -> RevenueForecast:
        return cls(
            historical=tuple(data.get("historical", [])),
            projected=tuple(data.get("projected", [])),
            method=ForecastMethod(data.get("method", ForecastMethod.CAGR.value)),
            confidence=ConfidenceLevel(data.get("confidence", ConfidenceLevel.MEDIUM.value)),
            growth_rates=tuple(data.get("growth_rates", [])),
        )


@dataclass(slots=True, frozen=True)
class MarginForecast(ForecastSeries):
    """Immutable domain model for operating or gross margin projections."""

    @classmethod
    from_dict(cls, data: Dict[str, Any]) -> MarginForecast:
        return cls(
            historical=tuple(data.get("historical", [])),
            projected=tuple(data.get("projected", [])),
            method=ForecastMethod(data.get("method", ForecastMethod.CAGR.value)),
            confidence=ConfidenceLevel(data.get("confidence", ConfidenceLevel.MEDIUM.value)),
        )


