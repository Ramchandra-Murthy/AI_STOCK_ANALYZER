# Copy this file to .streamlit/secrets.toml in your local deployment.
# For hosted deployments, add these values through the host's protected Secrets UI.
# Replace every placeholder; never commit real credentials.

[auth]
redirect_uri = "https://YOUR-DEPLOYED-APP-URL/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_OAUTH_CLIENT_ID"
client_secret = "YOUR_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
