    @staticmethod
    def _build_pipeline(
        source: Mapping[str, Any],
    ) -> list[Dict[str, Any]]:

        pipeline = []

        for item in source["pipeline_status"]:
            pipeline.append(
                {
                    "block_id": item.get("block_id"),
                    "name": item.get("name"),
                    "status": item.get("status"),
                    "identifier": item.get("identifier"),
                    "source_block": item.get("source_block"),
                    "execution_blocked": item.get(
                        "execution_blocked",
                        True,
                    ),
                }
            )

        return pipeline


