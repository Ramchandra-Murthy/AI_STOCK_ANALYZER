# ==========================================================
# EROS 3.0 — Production Environment Template (.env.example)
# ==========================================================

APP_ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
POSTGRES_USER=eros_admin
POSTGRES_PASSWORD=secure_production_password_change_me
POSTGRES_DB=eros_production
DATABASE_URL=postgresql://eros_admin:secure_production_password_change_me@postgres:5432/eros_production

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
JWT_SECRET_KEY=generate_a_secure_random_secret_key_for_production
CORS_ALLOWED_ORIGINS=["*"]

# Market Data Providers
MARKET_DATA_PROVIDER=yahoo
YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_ENABLED=true
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Worker Concurrency
WORKER_CONCURRENCY=4